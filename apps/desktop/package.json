{
  "name": "@zhicang/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "智藏 ZhiCang 桌面端",
  "main": "out/main/index.js",
  "author": "ZhiCang",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist": "node ../../scripts/assert-windows-packaging.mjs && electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "dist:win": "node ../../scripts/assert-windows-packaging.mjs && electron-vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac zip",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "node ../../scripts/run-desktop-tests.mjs"
  },
  "dependencies": {
    "@zhicang/shared": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "electron-updater": "^6.3.9",
    "react-force-graph-2d": "^1.29.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.20.0",
    "dayjs": "^1.11.0",
    "electron": "^31.3.0",
    "electron-builder": "24.13.3",
    "electron-vite": "^2.3.0",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "ai.zhicang.desktop",
    "productName": "ZhiCang",
    "electronVersion": "31.7.7",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "ZhiCang-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "智藏 ZhiCang",
      "artifactName": "ZhiCang-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ZhiCang-Portable-${version}-${arch}.${ext}"
    }
  },
  "license": "MIT"
}
