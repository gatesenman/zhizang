{
  "name": "@zhicang/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "智藏 ZhiCang 桌面端",
  "main": "out/main/index.js",
  "author": "ZhiCang",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild": "node packaging/rebuild-native.cjs",
    "postinstall": "node packaging/rebuild-native.cjs",
    "dist": "node ../../scripts/assert-windows-packaging.mjs && electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux zip --publish never",
    "dist:win": "node ../../scripts/assert-windows-packaging.mjs && electron-vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac zip",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "test": "node ../../scripts/run-desktop-tests.mjs"
  },
  "dependencies": {
    "@zhicang/shared": "workspace:*",
    "better-sqlite3": "13.2.0",
    "cheerio": "^1.0.0",
    "electron-updater": "6.8.12",
    "react-force-graph-2d": "^1.29.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.4.0",
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "antd": "^5.20.0",
    "dayjs": "^1.11.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vite": "7.3.8",
    "zustand": "^4.5.0",
    "electron-builder-squirrel-windows": "26.18.0"
  },
  "build": {
    "appId": "ai.zhicang.desktop",
    "productName": "ZhiCang",
    "electronVersion": "45.4.1",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "zip"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "ZhiCang-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "智藏 ZhiCang",
      "artifactName": "ZhiCang-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ZhiCang-Portable-${version}-${arch}.${ext}"
    },
    "beforePack": "./packaging/safe-packaging.cjs",
    "npmRebuild": false
  },
  "license": "MIT"
}
