# ===== 智藏 ZhiCang 后端 / 门户 环境变量模板 =====
# 复制为 .env 后按需修改： cp .env.example .env

# ---- 后端服务 ----
PORT=3001
# 本机开发可设 HOST=127.0.0.1；Docker 中保持 0.0.0.0
# HOST=127.0.0.1
# 生产环境强烈建议设置一个随机长字符串
JWT_SECRET=change-me-to-a-long-random-string

# ---- 全局限流（throttler，默认 60 秒内每 IP 120 次）----
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=120

# ---- 安全加固（可选，留空则用对开发友好的默认值）----
# CORS 来源白名单（逗号分隔）；留空放行任意来源。生产建议收紧为门户域名。
# CORS_ORIGINS=https://buy.example.com,https://www.example.com
# 管理员引导白名单（逗号分隔邮箱）；配置后仅这些邮箱注册时成为 admin。
# 留空则回退到「首个注册用户为管理员」（生产务必显式配置）。
# ADMIN_BOOTSTRAP_EMAILS=owner@example.com

# ---- 数据库 ----
# 设置 DATABASE_URL 则使用 PostgreSQL；不设置则后端回退到本地 SQLite 文件（SQL.js，无原生 ABI 冲突；仅适合单进程开发/试用）
# docker-compose 默认使用下面这一行（容器内主机名为 db）
DATABASE_URL=postgres://zhicang:zhicang@db:5432/zhicang
# 本机直接跑（非容器）时可改为：
# DATABASE_URL=postgres://zhicang:zhicang@localhost:5432/zhicang
DB_SYNC=true
DB_SSL=false
# 不使用 Postgres 时的 SQLite 路径（可选）
# SQLITE_PATH=./zhicang-backend.db

# ---- 许可证签名密钥（RS256）----
# 二选一：直接内联 PEM（换行用 \n），或指向文件路径
LICENSE_PRIVATE_KEY_PATH=./keys/license_private.pem
LICENSE_PUBLIC_KEY_PATH=./keys/license_public.pem
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---- 对外地址 ----
PUBLIC_BASE_URL=http://localhost:3001
PORTAL_URL=http://localhost:3002

# ---- 门户（Next.js，构建期注入）----
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# ---- 支付 / 邮件渠道 ----
# 注意：支付（mock|stripe|alipay|wechat）与邮件（console|smtp|sendgrid）渠道及其凭证
# 统一在「管理后台 → 设置」中配置（持久化到 settings 表，可热切换），不在此 .env 读取。
# 留空即默认走 mock 本地收银台 / console 打印邮件，便于先跑通流程，凭证后填。
# 详见 wiki/06-Backend-And-Licensing.md。
