# 可选自托管同步后端；纯本地桌面使用不需要此文件。
PORT=3001
# HOST=127.0.0.1
# 生产部署务必替换为足够长的随机值；仅用于同步账号 JWT，不是软件注册码。
JWT_SECRET=change-me-to-a-long-random-string
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=120
# CORS_ORIGINS=https://sync.example.com
# ADMIN_BOOTSTRAP_EMAILS=owner@example.com
# 不设置 DATABASE_URL 时使用 SQL.js SQLite（仅单进程、小型开发环境）。
# DATABASE_URL=postgres://zhicang:zhicang@localhost:5432/zhicang
# SQLITE_PATH=./zhicang-backend.db
# 生产数据库应先备份、审查 schema 差异；不要自动修改 schema。
DB_SYNC=false
DB_SSL=false
